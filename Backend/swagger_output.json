  /payments/refunds/:
    post:
      operationId: payments_refunds_create
      summary: Create Refund Request
      description: "Submit a new refund request for a completed transaction.\n\nRequest
        Body:\n- transaction_id: Target transaction ID (required)\n- reason: Refund
        reason (required)\n- additional_notes: Optional detailed explanation\n\nValid
        Reasons:\n- early_cancellation: Early booking cancellation\n- room_unavailable:
        Property became unavailable\n- platform_error: Technical or payment processing
        error\n\nProcess Flow:\n1. Validate transaction ownership and status\n2. Check
        for existing refund requests\n3. Validate refund reason against policy\n4.
        Calculate refund amount based on reason and timing\n5. Create refund request
        record\n6. Notify administrators for review\n7. Return request confirmation\n\nRefund
        Calculation Logic:\n- platform_error: 100% refund (full amount)\n- room_unavailable:
        100% refund (full amount)\n- early_cancellation: \n  * ≤7 days: 90% refund\n
        \ * ≤30 days: 70% refund\n  * >30 days: 50% refund\n\nReturns refund request
        details and processing information.\n\nError Handling:\n- 404: Transaction
        not found or not eligible\n- 400: Invalid reason or missing fields\n- 400:
        Refund already requested\n- 403: Unauthorized transaction access"
      parameters: []
      responses:
        '201':
          description: ''
      tags:
      - payments
    parameters: []
