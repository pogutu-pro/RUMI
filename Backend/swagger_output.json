  /accounts/login/:
    post:
      operationId: accounts_login_create
      summary: Authenticate User
      description: |-
        Authenticate user with email and password, then generate JWT tokens.

        Required Fields:
        - email: Registered email address
        - password: User password

        On successful authentication:
        - Generates access and refresh tokens
        - Sets secure HTTP-only cookies
        - Updates last login timestamp
        - Logs successful login with device info
        - Returns user profile data based on role

        Returns JWT tokens, user profile, and authentication status.
      parameters: []
      responses:
        '201':
          description: ''
      tags:
      - accounts
    parameters: []
  /accounts/logout/:
    post:
      operationId: accounts_logout_create
      description: Handle user logout
      parameters: []
      responses:
        '201':
          description: ''
      tags:
