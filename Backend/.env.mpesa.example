# M-Pesa Daraja API Configuration for RUMI Platform
# Copy this file to .env and fill in your actual M-Pesa credentials

# =============================================================================
# M-PESA API CONFIGURATION
# =============================================================================

# M-Pesa Consumer Key from Safaricom Developer Portal
# Get this from: https://developer.safaricom.co.ke
MPESA_CONSUMER_KEY=your_consumer_key_here

# M-Pesa Consumer Secret from Safaricom Developer Portal
# Get this from: https://developer.safaricom.co.ke
MPESA_CONSUMER_SECRET=your_consumer_secret_here

# M-Pesa Shortcode/Business Number
# Sandbox: 174379 (default)
# Production: Your actual business shortcode
MPESA_SHORTCODE=174379

# M-Pesa Passkey from Safaricom Developer Portal
# Sandbox: Use the standard sandbox passkey below
# Production: Get this from your Safaricom business account
MPESA_PASSKEY=bfb279f9aa9bdbcf158e97dd71a467cd2e0c893059b10f78e6b72ada1ed2c919

# =============================================================================
# WEBHOOK URLS (Must be publicly accessible for production)
# =============================================================================

# STK Push callback URL
MPESA_CALLBACK_URL=https://yourdomain.com/api/payments/webhook/mpesa/stk_push

# C2B validation URL (for offline payments)
MPESA_VALIDATION_URL=https://yourdomain.com/api/payments/webhook/mpesa/c2b_validation

# C2B confirmation URL (for offline payments)
MPESA_CONFIRMATION_URL=https://yourdomain.com/api/payments/webhook/mpesa/c2b_confirmation

# =============================================================================
# ENVIRONMENT SETTINGS
# =============================================================================

# Set to 'true' for sandbox testing, 'false' for production
MPESA_SANDBOX=true

# Frontend URL for redirects and callbacks
FRONTEND_URL=https://yourdomain.com

# =============================================================================
# OPTIONAL: PAYSTACK CONFIGURATION (for comparison)
# =============================================================================

# Paystack Public Key
PAYSTACK_PUBLIC_KEY=your_paystack_public_key

# Paystack Secret Key
PAYSTACK_SECRET_KEY=your_paystack_secret_key

# Paystack Webhook Secret
PAYSTACK_WEBHOOK_SECRET=your_paystack_webhook_secret

# =============================================================================
# SETUP INSTRUCTIONS
# =============================================================================

# 1. Register at https://developer.safaricom.co.ke
# 2. Create a new app and get your Consumer Key and Secret
# 3. Get your Business Shortcode from Safaricom
# 4. Generate a Passkey from your Safaricom account
# 5. Set up publicly accessible webhook URLs (HTTPS required for production)
# 6. Update the URLs above with your actual domain
# 7. Set MPESA_SANDBOX=false for production use
# 8. Copy this file to .env and fill in your credentials
# 9. Restart your Django application

# =============================================================================
# TESTING INFORMATION
# =============================================================================

# For sandbox testing, use these test numbers:
# - Phone: 254708374149 (PIN: 254079) ✅ Most reliable
# - Phone: 254700000000
# - Phone: 254711234567

# Test amounts: 100, 500, 1000 KES

# Quick Test Steps:
# 1. Register at https://developer.safaricom.co.ke
# 2. Create app and get Consumer Key & Secret
# 3. Copy this file to .env and fill in your credentials
# 4. Run test: python3 test_mpesa_connection.py
# 5. Test via Swagger: http://localhost:8000/swagger/

# =============================================================================
# SECURITY NOTES
# =============================================================================

# - Never commit .env file to version control
# - Use strong, unique passwords for all accounts
# - Ensure webhook URLs use HTTPS in production
# - Regularly rotate your API credentials
# - Monitor webhook logs for suspicious activity
# - Implement proper error handling and logging