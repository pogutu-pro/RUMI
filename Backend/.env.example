# =============================================================================
# RUMI Platform - Free Third Party API Configuration
# =============================================================================

# =============================================================================
# EMAIL SERVICES
# =============================================================================

# Mailtrap (Email Testing - Development)
MAILTRAP_API_KEY=your_mailtrap_api_key
MAILTRAP_USERNAME=your_mailtrap_username
MAILTRAP_PASSWORD=your_mailtrap_password

# =============================================================================
# SMS SERVICES
# =============================================================================

# kenya's Talking (SMS for Kenya)
kenyaSTALKING_API_KEY=your_kenyastalking_api_key
kenyaSTALKING_USERNAME=your_kenyastalking_username
kenyaSTALKING_FROM=RUMI

# =============================================================================
# PUSH NOTIFICATION SERVICES
# =============================================================================

# Firebase Cloud Messaging
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_PRIVATE_KEY=your_firebase_private_key
FIREBASE_CLIENT_EMAIL=your_firebase_client_email

# =============================================================================
# DOCUMENT VERIFICATION SERVICES
# =============================================================================

# Didit (Free Identity Verification)
DIDIT_API_KEY=your_didit_api_key

# =============================================================================
# CHAT & MESSAGING
# =============================================================================

# Socket.io (Self-hosted Real-time Messaging)
SOCKET_IO_SERVER_URL=http://localhost:3000

# =============================================================================
# DATABASE & CACHING
# =============================================================================

# Redis (Caching & Session Storage)
REDIS_URL=redis://localhost:6379/0
REDIS_PASSWORD=your_redis_password

# PostgreSQL (Production Database)
DATABASE_URL=postgresql://username:password@localhost:5432/rumi_db

# =============================================================================
# WEATHER SERVICES
# =============================================================================

# OpenWeatherMap
OPENWEATHER_API_KEY=your_openweather_api_key

# WeatherAPI
WEATHERAPI_KEY=your_weatherapi_key

# =============================================================================
# SOCIAL LOGIN SERVICES (Optional)
# =============================================================================

# Google OAuth
# Continue with Google (OAuth client ID, Web application). Leave empty to hide the button.
# Authorised JavaScript origins: https://rumiarent.com (and http://localhost:3000 for dev).
GOOGLE_CLIENT_ID=

# Facebook OAuth
FACEBOOK_APP_ID=your_facebook_app_id
FACEBOOK_APP_SECRET=your_facebook_app_secret

# =============================================================================
# PLATFORM CONFIGURATION
# =============================================================================

DEBUG=True
ENVIRONMENT=development

FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000

SECRET_KEY=your_django_secret_key
ALLOWED_HOSTS=localhost,127.0.0.1,rumi.ac.ke

CORS_ALLOWED_ORIGINS=http://localhost:3000,https://rumi.ac.ke

PLATFORM_NAME=RUMI
PLATFORM_TAGLINE=Student Accommodation Made Easy
SUPPORT_EMAIL=support@rumi.ac.ke
COUNTRY_CODE=KE
CURRENCY=KES
TIMEZONE=kenya/Nairobi

# =============================================================================
# NOTIFICATION PREFERENCES
# =============================================================================

DEFAULT_SMS_ENABLED=True
DEFAULT_EMAIL_ENABLED=True
DEFAULT_PUSH_ENABLED=False

NOTIFICATION_BRAND_NAME=RUMI Platform
NOTIFICATION_SUPPORT_EMAIL=support@rumi.ac.ke

# =============================================================================
# AWS S3 Media Storage (Production)
# Set USE_S3=true only AFTER running:
#   aws s3 sync Backend/media/ s3://$AWS_STORAGE_BUCKET_NAME/media/ --exclude "*.DS_Store"
# =============================================================================
USE_S3=False
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_STORAGE_BUCKET_NAME=your_bucket_name
AWS_S3_REGION_NAME=af-south-1
