[Unit]
Description=Deploy RumiaRent when GitHub main has new commits
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=oneshot
# Runs as the owner of /opt/rumi (a member of the docker group); its
# ~/.ssh/config points github.com at the read-only deploy key.
User=ubuntu
Group=ubuntu
ExecStart=/opt/rumi/deploy.sh
