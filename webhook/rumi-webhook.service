[Unit]
Description=RUMI GitHub Webhook Server
After=network.target docker.service

[Service]
Type=simple
User=root
WorkingDirectory=/opt/rumi/webhook
EnvironmentFile=/opt/rumi/.env.webhook
ExecStart=/usr/bin/python3 /opt/rumi/webhook/webhook_server.py
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
