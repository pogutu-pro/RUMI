# Django Backend
DEBUG=False
SECRET_KEY=change-this-to-a-long-random-secret-key
ALLOWED_HOSTS=rumia.co.ke,www.rumia.co.ke

# Database
DB_ENGINE=django.db.backends.postgresql
DB_NAME=rumi_db
DB_USER=rumi_user
DB_PASSWORD=change-this-db-password
DB_HOST=db
DB_PORT=5432

# Redis / Celery
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/1

# CORS
CORS_ALLOWED_ORIGINS=https://rumia.co.ke,https://www.rumia.co.ke

# Email (optional — uses SMTP)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=noreply@rumia.co.ke

# Frontend
NEXT_PUBLIC_API_URL=https://rumia.co.ke
BACKEND_INTERNAL_URL=http://backend:8000
