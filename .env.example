# Django Backend
DEBUG=False
SECRET_KEY=change-this-to-a-long-random-secret-key
ALLOWED_HOSTS=rumiarent.com,www.rumiarent.com

# Database
DB_ENGINE=django.db.backends.postgresql
DB_NAME=rumi_db
DB_USER=rumi_user
DB_PASSWORD=change-this-db-password
DB_HOST=db
DB_PORT=5432

# Redis / Celery
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/1

# CORS
CORS_ALLOWED_ORIGINS=https://rumiarent.com,https://www.rumiarent.com

# Email (optional — uses SMTP)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=noreply@rumiarent.com

# Frontend
NEXT_PUBLIC_API_URL=https://rumiarent.com/api/v1
BACKEND_INTERNAL_URL=http://backend:8000

# Paystack (payment processing)
PAYSTACK_SECRET_KEY=sk_test_your_paystack_secret_key
PAYSTACK_PUBLIC_KEY=pk_test_your_paystack_public_key

# Africa's Talking (SMS)
AFRICASTALKING_USERNAME=sandbox
AFRICASTALKING_API_KEY=your_africastalking_api_key
