# ==============================================
# RUMI PLATFORM - ENVIRONMENT CONFIGURATION
# ==============================================
# Copy this file to .env and fill in your values
# NEVER commit .env to version control!

# ==============================================
# DJANGO CONFIGURATION
# ==============================================
SECRET_KEY=your-super-secret-key-here-change-this-in-production
DEBUG=False
ALLOWED_HOSTS=rumi.co.ke,www.rumi.co.ke,localhost,127.0.0.1

# ==============================================
# DATABASE CONFIGURATION (PostgreSQL)
# ==============================================
DB_ENGINE=django.db.backends.postgresql
DB_NAME=rumi_production
DB_USER=rumi_user
DB_PASSWORD=strong_database_password_here
DB_HOST=localhost
DB_PORT=5432

# For development, you can use SQLite:
# DB_ENGINE=django.db.backends.sqlite3
# DB_NAME=db.sqlite3

# ==============================================
# REDIS CONFIGURATION
# ==============================================
REDIS_URL=redis://localhost:6379/0

# ==============================================
# EMAIL CONFIGURATION
# ==============================================
# For development (Mailtrap)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.mailtrap.io
EMAIL_PORT=587
EMAIL_USE_TLS=True
MAILTRAP_USERNAME=your_mailtrap_username
MAILTRAP_PASSWORD=your_mailtrap_password

# For production (use real SMTP provider like SendGrid, AWS SES, etc.)
# EMAIL_HOST=smtp.sendgrid.net
# EMAIL_HOST_USER=apikey
# EMAIL_HOST_PASSWORD=your_sendgrid_api_key

DEFAULT_FROM_EMAIL=noreply@rumi.co.ke

# ==============================================
# SMS CONFIGURATION (Africa's Talking)
# ==============================================
AFRICASTALKING_USERNAME=rumi
AFRICASTALKING_API_KEY=your_africastalking_api_key_here

# ==============================================
# PAYMENT GATEWAY (Paystack)
# ==============================================
# Test keys (for development)
PAYSTACK_PUBLIC_KEY=pk_test_your_test_public_key
PAYSTACK_SECRET_KEY=sk_test_your_test_secret_key
PAYSTACK_WEBHOOK_SECRET=whsec_test_your_webhook_secret

# Live keys (for production - KEEP SECURE!)
# PAYSTACK_PUBLIC_KEY=pk_live_your_live_public_key
# PAYSTACK_SECRET_KEY=sk_live_your_live_secret_key
# PAYSTACK_WEBHOOK_SECRET=whsec_live_your_webhook_secret

# ==============================================
# CORS CONFIGURATION
# ==============================================
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,https://rumi.co.ke

# ==============================================
# SECURITY SETTINGS
# ==============================================
# Set to True in production
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
SECURE_HSTS_SECONDS=0

# In production, set these to True:
# SECURE_SSL_REDIRECT=True
# SESSION_COOKIE_SECURE=True
# CSRF_COOKIE_SECURE=True
# SECURE_HSTS_SECONDS=31536000

# ==============================================
# LOGGING
# ==============================================
LOG_LEVEL=INFO

# ==============================================
# CELERY CONFIGURATION
# ==============================================
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# ==============================================
# STATIC & MEDIA FILES
# ==============================================
# For production, use cloud storage (AWS S3, Cloudinary, etc.)
# AWS_ACCESS_KEY_ID=your_aws_access_key
# AWS_SECRET_ACCESS_KEY=your_aws_secret_key
# AWS_STORAGE_BUCKET_NAME=rumi-platform
# AWS_S3_REGION_NAME=us-east-1

# ==============================================
# MONITORING & ERROR TRACKING
# ==============================================
# SENTRY_DSN=your_sentry_dsn_here

# ==============================================
# SUBSCRIPTION CONFIGURATION
# ==============================================
SUBSCRIPTION_TRIAL_DAYS=30
BASIC_PLAN_PRICE=10000.00
MEDIUM_PLAN_PRICE=30000.00
ADVANCED_PLAN_PRICE=40000.00

# ==============================================
# PLATFORM FEES
# ==============================================
PLATFORM_SERVICE_FEE=0.02
PLATFORM_FEE_LANDLORD=0.00
PAYSTACK_FEE_RATE=0.015
NET_PLATFORM_FEE=0.005
WITHHOLDING_TAX_RATE=0.00

# ==============================================
# FRONTEND CONFIGURATION
# ==============================================
VITE_API_URL=http://localhost:8000/api/v1

# For production:
# VITE_API_URL=https://api.rumi.co.ke/api/v1